#!/usr/bin/env bash
set -euo pipefail

branch=$1
base=$2
[[ "$branch" =~ ^release/v([0-9]+\.[0-9]+\.[0-9]+)$ ]]
version=${BASH_REMATCH[1]}
tag="v$version"
path=lib/request_rescue/version.rb
head=$3
release=$(git rev-parse --verify "refs/tags/$tag^{commit}")

# Accept exactly the tagged, single-parent version bump on the current base.
[[ "$(git rev-list --parents -n 1 "$release")" == "$release $(git rev-parse "$base")" ]]
[[ "$(git diff --name-only "$base" "$release")" == "$path" ]]
[[ -z "$(git diff --summary "$base" "$release" -- "$path")" ]]
expected=$(git show "$base:$path" |
  sed -E "s/^  VERSION = \"[0-9]+\.[0-9]+\.[0-9]+\"$/  VERSION = \"$version\"/" |
  git hash-object --stdin)
[[ "$(git ls-tree "$release" -- "$path")" == "100644 blob $expected"$'\t'"$path" ]]

# The maintainer commit may only refresh the choices in the dispatch form.
form=.github/workflows/release.yml
[[ "$(git rev-list --parents -n 1 "$head")" == "$head $release" ]]
[[ "$(git diff --name-only "$release" "$head")" == "$form" ]]
expected=$(git show "$release:$form" | ruby bin/prepare-release --form "$version" | git hash-object --stdin)
[[ "$(git ls-tree "$head" -- "$form")" == "100644 blob $expected"$'\t'"$form" ]]

curl -fsS --retry 2 "https://rubygems.org/api/v2/rubygems/request-rescue/versions/$version.json" |
  jq -e --arg version "$version" '.version == $version and .platform == "ruby"' >/dev/null
