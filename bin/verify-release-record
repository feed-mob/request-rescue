#!/usr/bin/env bash
set -euo pipefail

branch=$1
base=$2
[[ "$branch" =~ ^release/v([0-9]+\.[0-9]+\.[0-9]+)$ ]]
version=${BASH_REMATCH[1]}
tag="v$version"
path=lib/request_rescue/version.rb
head=$3
[[ "$(git rev-parse --verify "refs/tags/$tag^{commit}")" == "$head" ]]

# Accept exactly the tagged, single-parent version bump on the current base.
[[ "$(git rev-list --parents -n 1 "$head")" == "$head $(git rev-parse "$base")" ]]
[[ "$(git diff --name-only "$base" "$head")" == "$path" ]]
[[ -z "$(git diff --summary "$base" "$head" -- "$path")" ]]
expected=$(git show "$base:$path" |
  sed -E "s/^  VERSION = \"[0-9]+\.[0-9]+\.[0-9]+\"$/  VERSION = \"$version\"/" |
  git hash-object --stdin)
[[ "$(git ls-tree "$head" -- "$path")" == "100644 blob $expected"$'\t'"$path" ]]

curl -fsS --retry 2 "https://rubygems.org/api/v2/rubygems/request-rescue/versions/$version.json" |
  jq -e --arg version "$version" '.version == $version and .platform == "ruby"' >/dev/null
