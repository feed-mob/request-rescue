#!/usr/bin/env bash
set -euo pipefail

version=${1:-}
[[ "$#" == 1 && "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "Usage: bin/refresh-release-form X.Y.Z" >&2; exit 1; }
branch="release/v$version"
repo="feed-mob/request-rescue"
path=".github/workflows/release.yml"
endpoint="repos/$repo/contents/$path"
state=$(gh pr list --repo "$repo" --base main --head "$branch" --state open --json isCrossRepository --jq 'any(.[]; .isCrossRepository == false)')
[[ "$state" == true ]] || { echo "No open version update PR for $branch" >&2; exit 1; }

# Update only the form in the remote PR, using the maintainer's gh login.
file=$(gh api "$endpoint?ref=$branch")
payload=$(jq -rj '.content | gsub("\n"; "") | @base64d' <<< "$file" |
  ruby "$(dirname "$0")/prepare-release" --form "$version" |
  jq -Rs --arg branch "$branch" --arg sha "$(jq -r .sha <<< "$file")" \
    '{branch: $branch, sha: $sha, content: @base64, message: ("chore(release): Refresh version choices for " + $branch)}')
if [[ "$(jq -r .content <<< "$payload")" == "$(jq -r '.content | gsub("\n"; "")' <<< "$file")" ]]; then
  echo "Release choices are already up to date."
else
  gh api --method PUT "$endpoint" --input - --jq '.commit.html_url' <<< "$payload"
fi
