#!/usr/bin/env ruby
require_relative "../lib/request_rescue/version"

current = RequestRescue::VERSION
stable = /\A(?:0|[1-9]\d*)(?:\.(?:0|[1-9]\d*)){2}\z/
abort "Expected a stable X.Y.Z version, got #{current.inspect}" unless stable.match?(current.to_s)
major, minor, patch = current.split(".").map(&:to_i)
options = {
  "patch" => "#{major}.#{minor}.#{patch + 1}",
  "minor" => "#{major}.#{minor + 1}.0",
  "major" => "#{major + 1}.0.0"
}

abort "Choose patch, minor, or major" unless ARGV.size == 1 && options.key?(ARGV.first)
version = options.fetch(ARGV.first)

path = File.expand_path("../lib/request_rescue/version.rb", __dir__)
source = File.read(path)
updated = source.sub(%Q(VERSION = "#{current}"), %Q(VERSION = "#{version}"))
abort "Could not update #{path}" if updated == source
File.write(path, updated)
puts version
